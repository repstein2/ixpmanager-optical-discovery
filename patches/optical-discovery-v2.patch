diff --git a/app/Optics/AristaTransceiverParser.php b/app/Optics/AristaTransceiverParser.php
new file mode 100644
index 000000000..36b3f03d0
--- /dev/null
+++ b/app/Optics/AristaTransceiverParser.php
@@ -0,0 +1,55 @@
+<?php
+
+namespace IXP\Optics;
+
+class AristaTransceiverParser
+{
+    /**
+     * Parse ENTITY-MIB descriptions into physical-port media mappings.
+     *
+     * @param array $descriptions entPhysicalDescr records
+     * @return array<string, string>
+     */
+    public static function parse(array $descriptions): array
+    {
+        $result = [];
+        $conflicts = [];
+
+        foreach ($descriptions as $description) {
+            if (!is_string($description)) {
+                continue;
+            }
+
+            if (!preg_match(
+                '~^Xcvr for (Ethernet[0-9]+(?:/[0-9]+)*):.*?\bmedia\s+([A-Za-z0-9][A-Za-z0-9._+-]*)\s*$~i',
+                trim($description),
+                $matches
+            )) {
+                continue;
+            }
+
+            $port = $matches[1];
+            $media = $matches[2];
+
+            // Ignore switch-reported unknown optical classifications.
+            if (preg_match('/^Unknown(?:Optical.*)?$/i', $media)) {
+                continue;
+            }
+
+            if (isset($result[$port]) && $result[$port] !== $media) {
+                $conflicts[$port] = true;
+                continue;
+            }
+
+            if (!isset($conflicts[$port])) {
+                $result[$port] = $media;
+            }
+        }
+
+        foreach (array_keys($conflicts) as $port) {
+            unset($result[$port]);
+        }
+
+        return $result;
+    }
+}
diff --git a/app/Optics/TransceiverDiscovery.php b/app/Optics/TransceiverDiscovery.php
new file mode 100644
index 000000000..928bb3da2
--- /dev/null
+++ b/app/Optics/TransceiverDiscovery.php
@@ -0,0 +1,65 @@
+<?php
+
+namespace IXP\Optics;
+
+use OSS_SNMP\SNMP;
+
+class TransceiverDiscovery
+{
+    /**
+     * Discover transceiver media from Arista ENTITY-MIB.
+     *
+     * Distinguishes successful empty inventory from polling failure.
+     *
+     * @return array{success: bool, media: array<string,string>, error: ?string}
+     */
+    public static function discoverWithStatus(
+        SNMP $host,
+        bool $isArista
+    ): array {
+        if (!$isArista) {
+            return [
+                'success' => false,
+                'media' => [],
+                'error' => 'Unsupported vendor',
+            ];
+        }
+
+        try {
+            $descriptions = $host->useEntity()->physicalDescription();
+
+            if (!is_array($descriptions)) {
+                return [
+                    'success' => false,
+                    'media' => [],
+                    'error' => 'Invalid ENTITY-MIB response',
+                ];
+            }
+
+            return [
+                'success' => true,
+                'media' => AristaTransceiverParser::parse($descriptions),
+                'error' => null,
+            ];
+
+        } catch (\Throwable $e) {
+            return [
+                'success' => false,
+                'media' => [],
+                'error' => 'SNMP ENTITY-MIB query failed',
+            ];
+        }
+    }
+
+    /**
+     * Backward-compatible discovery method.
+     *
+     * @return array<string,string>
+     */
+    public static function discover(
+        SNMP $host,
+        bool $isArista
+    ): array {
+        return self::discoverWithStatus($host, $isArista)['media'];
+    }
+}
